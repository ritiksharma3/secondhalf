# --- LLM provider (required) ---
# Groq is used for both the teacher (offline data-generation) and the final
# recommendation LLM. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- LangSmith tracing (optional) ---
# Leave LANGCHAIN_TRACING_V2 unset/false to run with tracing disabled -
# the app must work either way.
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=secondhalf
